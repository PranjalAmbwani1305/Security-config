# Copy to backend/.env for local development. In AWS, inject these from
# Secrets Manager / SSM Parameter Store instead of a file.
ENVIRONMENT=development

# Required. Local example only.
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel

# Required, >= 32 chars. Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-change-me-change-me-change-me-change-me

# Explicit origins only (comma-separated). Never "*". Must be https in production.
CORS_ORIGINS=http://localhost:5173

# Optional: enables "Sign in with Google" (OAuth 2.0 Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Used by later increments
LLM_PROVIDER=mock
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Dev only: allow webhook targets on loopback/private addresses (SSRF guard off). Must be false in production.
WEBHOOK_ALLOW_PRIVATE=false
